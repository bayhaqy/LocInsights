model CompetitorStore {
  @@map("competitor_stores")
  id              String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  brand_name      String
  brand_category  competitor_category_enum  @default(other)
  name            String
  lat             Float
  lng             Float
  geom            Unsupported("geography")? @default(dbgenerated("(st_makepoint(lng, lat))::geography"))
  kec             String?                   @default("")
  kab             String?                   @default("")
  city            String?                   @default("")
  country         String?                   @default("Indonesia")
  address         String?                   @default("")
  is_in_mall      Boolean?                  @default(false)
  mall_id         String?
  mall_name       String?
  source          scraper_source_enum?      @default(osm)
  source_url      String?                   @default("")
  last_crawled_at DateTime?                 @default(now()) @db.Timestamptz(6)
  created_at      DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime                  @default(now()) @db.Timestamptz(6)
  malls           Mall?                    @relation(fields: [mall_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([brand_name], map: "competitor_brand_idx")
  @@index([brand_category], map: "competitor_category_idx")
  @@index([geom], map: "competitor_geom_idx", type: Gist)
  @@index([kab], map: "competitor_kab_idx")
