// LocInsight Prisma schema
// All master data is editable via the Data Manager UI.
// The seed scripts import the original static .ts data files into these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================
// Master data — editable via Data Manager CRUD UI
// =============================================================

model Brand {
  id                  String   @id
  name                String
  parent              String   // 'MAP' | 'MAA'
  category            String   // 'food_beverage' | 'sports' | 'fashion' | 'department_store' | 'kids' | 'lifestyle' | 'beauty'
  origin_country      String
  format              String
  location_preference String   // 'mall' | 'street' | 'both'
  typical_size_m2     Int
  target_audience     String
  price_segment       String   // 'mass' | 'mid' | 'premium' | 'luxury'
  brand_strength      Float    // 0-1
  notes               String   @default("")
  city                String   @default("") // HQ city (e.g., 'Jakarta' for MAP HQ)
  country             String   @default("Indonesia") // HQ country
  source              String   @default("map.co.id/brands") // provenance of this record
  stores              Store[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Mall {
  id                  String   @id
  name                String
  lat                 Float
  lng                 Float
  kec                 String
  kab                 String
  city                String   @default("") // city/kota name (e.g., 'Denpasar', 'Kuta')
  country             String   @default("Indonesia")
  gla_m2              Int
  opened_year         Int
  class               String   // 'super_regional' | 'regional' | 'community' | 'specialty'
  anchor_count        Int      @default(0)
  has_cinema          Boolean  @default(false)
  has_supermarket     Boolean  @default(false)
  has_department_store Boolean @default(false)
  visitor_estimate_daily Int
  notes               String   @default("")
  source              String   @default("nowbali.co.id") // provenance
  stores              Store[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Store {
  id              String   @id
  brand_id        String
  brand_name      String
  brand_category  String
  parent          String   // 'MAP' | 'MAA'
  name            String
  lat             Float
  lng             Float
  kec             String
  kab             String
  city            String   @default("") // city/kota
  country         String   @default("Indonesia")
  is_in_mall      Boolean  @default(false)
  mall_id         String?
  mall_name       String?
  address         String
  opened_year     Int
  estimated_size_m2 Int    @default(0)
  confirmed       Boolean  @default(false)
  source          String   @default("map.co.id directory") // provenance
  brand           Brand?   @relation(fields: [brand_id], references: [id])
  mall            Mall?    @relation(fields: [mall_id], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Poi {
  id        String   @id
  name      String
  type      String   // 'tourist_attraction' | 'beach' | 'temple' | 'hotel_cluster' | 'transit_hub' | 'university' | 'hospital' | 'office_cluster' | 'port'
  lat       Float
  lng       Float
  kec       String
  kab       String
  city      String   @default("") // city/kota
  country   String   @default("Indonesia")
  magnitude Float
  notes     String   @default("")
  source    String   @default("Google Maps POI") // provenance
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kelurahan {
  id                  String   @id
  code                String
  name                String
  kec_code            String
  kec_name            String
  kab_code            String
  kab_name            String
  city                String   @default("") // city/kota (== kab_name when same, e.g., Denpasar)
  country             String   @default("Indonesia")
  tier                Int      // 1 | 2 | 3
  lat                 Float
  lng                 Float
  population          Int
  area_km2            Float
  density             Int
  urban_index         Int
  income_index        Int
  tourist_index       Int
  transport_index     Int
  poi_density_index   Int
  is_coastal          Boolean  @default(false)
  source              String   @default("BPS Bali 2024") // provenance
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Kabupaten {
  code                String   @id
  name                String
  type                String   // 'Kabupaten' | 'Kota'
  capital             String
  lat                 Float
  lng                 Float
  city                String   @default("") // For Kota-type, == name; for Kabupaten, == capital
  country             String   @default("Indonesia")
  province            String   @default("Bali")
  area_km2            Float
  population_2024     Int
  population_density  Int
  gdrp_per_capita_juta Float
  tier                Int
  hdmi_2024           Float
  tourist_hotels      Int
  notes               String   @default("")
  source              String   @default("BPS Bali 2024") // provenance
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Kecamatan {
  code            String   @id
  name            String
  kabupaten_code  String
  city            String   @default("") // city/kota
  country         String   @default("Indonesia")
  province        String   @default("Bali")
  lat             Float
  lng             Float
  population_2024 Int
  area_km2        Float
  tier            Int
  urban_score     Int
  is_capital      Boolean  @default(false)
  source          String   @default("BPS Bali 2024") // provenance
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// =============================================================
// ML/AI — model metadata, training runs, predictions
// =============================================================

model MLModel {
  id              String   @id
  name            String
  version         String
  type            String   // 'site_scoring' | 'revenue_forecast' | 'cannibalization' | 'cluster'
  algorithm       String   // 'huff_gravity' | 'xgboost' | 'random_forest' | 'kmeans' | 'dbscan'
  description     String
  features        String   // JSON array
  hyperparameters String   // JSON
  metrics         String   // JSON: { rmse, mae, r2, ... }
  status          String   @default("active") // 'active' | 'archived' | 'experimental'
  trained_at      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  predictions     Prediction[]
}

model Prediction {
  id           String   @id @default(cuid())
  model_id     String
  model        MLModel  @relation(fields: [model_id], references: [id])
  target_type  String   // 'kelurahan' | 'store' | 'mall'
  target_id    String
  target_name  String
  prediction   Float
  confidence   Float    @default(0)
  explanation  String   // JSON
  createdAt    DateTime @default(now())
}

// =============================================================
// Scraper runs — log of all OSM/external data scraping operations
// =============================================================

model ScraperRun {
  id          String   @id @default(cuid())
  query       String
  source      String   // 'nominatim' | 'overpass' | 'manual' | 'bps'
  status      String   // 'pending' | 'running' | 'success' | 'failed' | 'partial'
  found_count Int      @default(0)
  saved_count Int      @default(0)
  error       String?
  result_json String   @default("[]") // JSON of found items
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
}

// =============================================================
// Reports — generated report metadata
// =============================================================

model Report {
  id          String   @id @default(cuid())
  title       String
  type        String   // 'executive_summary' | 'site_analysis' | 'brand_expansion' | 'regional_comparison'
  format      String   // 'pdf' | 'xlsx' | 'csv' | 'json'
  filters     String   @default("{}") // JSON
  status      String   @default("pending") // 'pending' | 'generated' | 'failed'
  file_path   String?
  file_size_kb Int?
  generated_by String  @default("system")
  createdAt   DateTime @default(now())
}

// =============================================================
// Phase 2: Competitor stores (Indomaret, Alfamart, McDonald's, KFC, etc.)
// Populated via the scraper module (mode='competitor') + manual entry.
// =============================================================

model CompetitorStore {
  id          String   @id @default(cuid())
  brand_name  String   // 'Indomaret', 'Alfamart', 'McDonald''s', etc.
  brand_category String // 'convenience_store' | 'fast_food' | 'coffee' | 'fashion' | 'beauty' | 'supermarket' | 'pharmacy' | 'other'
  name        String   // specific outlet name (e.g., 'Indomaret Kuta Utara')
  lat         Float
  lng         Float
  kec         String   @default("")
  kab         String   @default("")
  city        String   @default("")
  country     String   @default("Indonesia")
  address     String   @default("")
  is_in_mall  Boolean  @default(false)
  mall_id     String?
  mall_name   String?
  source      String   @default("osm_nominatim")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =============================================================
// Phase 3: ML training runs (auto-retrain pipeline)
// =============================================================

model TrainingRun {
  id              String   @id @default(cuid())
  model_id        String   // references MLModel.id
  model_name      String
  algorithm       String
  status          String   // 'pending' | 'running' | 'completed' | 'failed'
  dataset_size    Int      @default(0)
  features        String   @default("[]") // JSON array of feature names
  hyperparameters String   @default("{}") // JSON
  metrics         String   @default("{}") // JSON: { rmse, mae, r2, mape }
  feature_importance String @default("[]") // JSON: [{feature, importance}]
  model_artifact  String?  // path to JSON model file under prisma/ml-models/
  train_duration_ms Int?
  error           String?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
}

// =============================================================
// Phase 3: Field surveyor (offline PWA form submissions)
// =============================================================

model FieldSurvey {
  id            String   @id @default(cuid())
  kelurahan_id  String?
  kelurahan_name String  @default("")
  lat           Float
  lng           Float
  accuracy_m    Float?
  surveyor_name String
  survey_type   String   // 'site_visit' | 'competitor_audit' | 'mall_audit' | 'market_observations'
  brand_name    String?  // brand observed (if any)
  brand_category String? @default("")
  outlet_name   String?  @default("")
  address       String?  @default("")
  is_in_mall    Boolean  @default(false)
  mall_name     String?  @default("")
  condition     String?  @default("") // 'excellent' | 'good' | 'fair' | 'poor' | 'under_construction'
  estimated_size_m2 Int?
  foot_traffic_observation String? @default("") // 'low' | 'medium' | 'high' | 'very_high'
  notes         String   @default("")
  photo_urls    String   @default("[]") // JSON array of relative URLs
  review_status String   @default("pending") // 'pending' | 'approved' | 'rejected' | 'imported'
  reviewer_notes String  @default("")
  submittedAt   DateTime @default(now())
  reviewedAt    DateTime?
}

// =============================================================
// Phase 3: Mall tenant directory (live integration from scraper)
// =============================================================

model MallTenant {
  id          String   @id @default(cuid())
  mall_id     String?
  mall_name   String
  brand_name  String
  brand_category String @default("")
  is_map_brand Boolean @default(false) // true if brand is in MAP/MAA portfolio
  is_competitor Boolean @default(false)
  floor       String?  @default("")
  category    String   @default("")
  source      String   @default("osm_nominatim")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
